# ── Flask Application ─────────────────────────────────────────
FLASK_ENV=production
SECRET_KEY=change-me-to-a-random-string

# ── Tally Connection (LOCAL mode) ─────────────────────────────
# Direct URL to TallyPrime HTTP server on the local machine.
TALLY_HTTP_URL=http://127.0.0.1:9000
TALLY_COMPANY_NAME=

# ── Tally Connection (CLOUD mode) ────────────────────────────
# Set this to the public URL of the local agent running on your
# Windows PC.  When set, /api/push and /api/status will proxy
# through this connector instead of calling localhost:9000.
# Example: TALLY_CONNECTOR_URL=https://abc123.loca.lt
TALLY_CONNECTOR_URL=

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins.  Use "*" for dev.
CORS_ORIGINS=*

# ── Chirix ERP API ───────────────────────────────────────────
CHIRIX_API_URL=https://www.chirixsolutions.com/api/data

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Local Agent (only if running tally/local_agent.py) ───────
AGENT_PORT=6190
AGENT_SECRET=
